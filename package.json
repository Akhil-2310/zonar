{
  "name": "zonar",
  "version": "0.1.0",
  "description": "Zonar - a two-player fog-of-war hunt for a hidden vault of ZEC",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "node --disable-warning=ExperimentalWarning server/index.ts",
    "build": "next build",
    "start": "NODE_ENV=production node --disable-warning=ExperimentalWarning server/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --disable-warning=ExperimentalWarning --test test/*.test.ts"
  },
  "engines": {
    "node": ">=23.6"
  },
  "dependencies": {
    "@noble/ciphers": "1.3.0",
    "@noble/curves": "1.9.7",
    "@noble/hashes": "1.8.0",
    "next": "16.4.2",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "playwright": "1.64.1",
    "postcss": "8.5.32",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3"
  }
}
